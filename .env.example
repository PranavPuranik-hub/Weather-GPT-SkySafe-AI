# ==============================================================================
# WeatherGPT / SkySafe AI — Production & Local Environment Configuration
# Copy this file to .env and provide your production secrets. NEVER commit .env!
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Server & Deployment Configuration
# ------------------------------------------------------------------------------
# Application mode: "live" for real-time Open-Meteo & IMD RSS/CAP feeds; "fixtures" for offline demo
MODE=live

# Port (assigned automatically by hosting platforms like Render via $PORT)
PORT=8000

# Project metadata
PROJECT_NAME="SkySafe AI"
VERSION="0.1.0"
DEMO_DISTRICT=Cuttack

# ------------------------------------------------------------------------------
# 2. Database Configuration (Supabase PostgreSQL / Managed PostgreSQL / SQLite)
# ------------------------------------------------------------------------------
# If omitted, SQLite (app_test.db) is used automatically with resilient fallback.
# For Supabase / Render PostgreSQL: postgresql://user:password@host:5432/dbname
DATABASE_URL=

# ------------------------------------------------------------------------------
# 3. AI & LLM Provider Configuration
# ------------------------------------------------------------------------------
# Provider: "gemini" | "groq" | "ollama" | "null"
LLM_PROVIDER=gemini
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.6-flash
GEMINI_TIMEOUT=8.0

# Optional fallback LLM providers
GROQ_API_KEY=
OLLAMA_URL=http://localhost:11434

# ------------------------------------------------------------------------------
# 4. Voice Synthesis & Regional Indian Languages (Sarvam AI / Edge-TTS)
# ------------------------------------------------------------------------------
SARVAM_API_KEY=your_sarvam_api_key_here

# ------------------------------------------------------------------------------
# 5. Security & CORS Configuration
# ------------------------------------------------------------------------------
# Comma-separated list of allowed origins. Vercel *.vercel.app is allowed via regex.
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
FRONTEND_URL=https://your-production-frontend.vercel.app

# ------------------------------------------------------------------------------
# 6. Frontend Production API Resolution (Vercel)
# ------------------------------------------------------------------------------
# Public URL of the backend API deployed on Render (e.g. https://weathergpt-api.onrender.com)
NEXT_PUBLIC_API_URL=
BACKEND_URL=

# ------------------------------------------------------------------------------
# 7. Optional SMS & Emergency Broadcasting (Twilio)
# ------------------------------------------------------------------------------
TWILIO_ENABLED=false
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
